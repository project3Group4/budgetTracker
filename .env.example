# Never commit real secrets
# Copy to .env in the api directory
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate locally: openssl rand -base64 32
APP_JWT_SECRET_BASE64=
# Put the url, user, and password from your remote database here
DB_URL=
DB_USER=
DB_PASSWORD=


# Copy to .env in the root directory
POSTGRES_PASSWORD=replace-with-local-password


# Copy to .env in the app directory
EXPO_PUBLIC_GITHUB_CLIENT_ID=
